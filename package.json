{
  "name": "jufe-offer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .cache/eslint/.eslintcache --cache-strategy content",
    "typecheck": "next typegen && tsc --noEmit",
    "analyze": "next experimental-analyze --output",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "hash-password": "tsx scripts/hash-password.ts",
    "generate:technology-sprite": "tsx scripts/generate-technology-sprite.ts",
    "sync:campus-projects": "tsx scripts/campus-project-avatars.ts",
    "sync:campus-project-avatars": "tsx scripts/campus-project-avatars.ts",
    "friend-link-bot": "tsx scripts/friend-link-bot.ts",
    "test:friend-links": "tsx --test scripts/friend-link-bot.test.ts scripts/campus-project-avatars.test.ts scripts/remote-resource-admin.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@egjs/react-grid": "^1.19.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.525.0",
    "matter-js": "^0.20.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.60.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "prisma": "^6.19.3",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@11.11.0"
}
