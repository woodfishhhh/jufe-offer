generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CandidateCategory {
  INTERNSHIP
  CAMPUS_RECRUITMENT
  REFERRAL
  COMPETITION
  HACKATHON
  OPEN_SOURCE_RESOURCE
  TRAINING
  PROGRAMMING_LEARNING
  LEARNING_PATH
  PROGRAMMING_TOOL
  CAREER_EXPERIENCE
  RESUME_INTERVIEW
  CAMPUS_RESOURCE
  OTHER_RESOURCE
}

enum ResourceOrigin {
  SEED
  MANUAL
  OPENCLAW
}

enum CandidateSourceType {
  RSSHUB
  OFFICIAL_API
  OFFICIAL_PAGE
  WEB_MONITOR
  MANUAL_RESEARCH
}

enum CandidateIngestDisposition {
  AUTO_PUBLISH
  REVIEW_REQUIRED
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
}

model Resource {
  id                String             @id @default(cuid())
  title             String
  description       String
  url               String
  category          String
  tags              String
  isFeatured        Boolean            @default(false)
  origin            ResourceOrigin     @default(MANUAL)
  startsAt          DateTime?
  deadlineAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  candidates        Candidate[]
  repositoryProfile RepositoryProfile?
}

model RepositoryProfile {
  id              String    @id @default(cuid())
  repositoryUrl   String    @unique
  owner           String
  name            String
  description     String?
  stars           Int       @default(0)
  avatarPath      String?
  avatarLogin     String?
  primaryLanguage String?
  resourceId      String?   @unique
  resource        Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  syncedAt        DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Candidate {
  id                String                     @id @default(cuid())
  externalId        String                     @unique
  dedupeKey         String                     @unique
  category          CandidateCategory
  title             String
  summary           String
  sourceType        CandidateSourceType
  sourceName        String
  sourceUrl         String
  officialUrl       String?
  deadline          DateTime?
  tags              String
  rawExcerpt        String?
  discoveredAt      DateTime
  ingestDisposition CandidateIngestDisposition
  status            CandidateStatus            @default(PENDING)
  reviewNote        String?
  reviewedAt        DateTime?
  resourceId        String?
  resource          Resource?                  @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([category, status])
  @@index([resourceId])
}

model SiteMetric {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id              String   @id @default(cuid())
  eventType       String
  eventName       String?
  path            String
  title           String?
  referrerHost    String?
  sessionId       String
  visitorId       String
  browser         String
  operatingSystem String
  device          String
  language        String?
  timezone        String?
  metricName      String?
  metricValue     Float?
  metricRating    String?
  dataJson        String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([createdAt, eventType])
  @@index([sessionId, createdAt])
  @@index([path, eventType])
  @@index([visitorId, createdAt])
}
