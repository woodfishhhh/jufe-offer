# SQLite 数据库。相对路径以 prisma/ 目录为基准。
DATABASE_URL="file:./dev.db"

# 唯一的管理员账号
ADMIN_USERNAME=admin
# 推荐直接粘贴 `pnpm hash-password` 输出的 hex 值，避免 $ 被展开
ADMIN_PASSWORD_HASH=


# 用于签发登录 Cookie 的密钥，请换成足够长的随机字符串
SESSION_SECRET=

# 用于 sitemap、robots 和 Open Graph 的站点地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 生产环境示例：NEXT_PUBLIC_SITE_URL=https://jufe.woodfish.site
